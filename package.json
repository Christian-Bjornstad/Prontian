{
  "name": "prontian-quality-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint eslint.config.js scripts/*.mjs pronto_report/static/*.js",
    "format:check": "prettier --check eslint.config.js scripts/*.mjs pronto_report/static/*.js pronto_report/static/*.css",
    "format": "prettier --write eslint.config.js scripts/*.mjs pronto_report/static/*.js pronto_report/static/*.css",
    "docs:diagrams": "node scripts/check_diagrams.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "mermaid": "12.3.0",
    "jsdom": "30.1.3"
  },
  "overrides": { "minimatch": "11.0.1" }
}
